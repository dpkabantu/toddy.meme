{
  "name": "toddy-meme",
  "main": "server/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": ".",
    // Only /api/* runs the Worker (accounts). Every other URL is served straight from the files, as before.
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Serve /404.html (with a real 404 status) for unknown URLs instead of a blank error.
    "not_found_handling": "404-page"
  },
  // Private preview copies for test branches (e.g. games-beta). Needed by
  // `npx wrangler preview` in Cloudflare's preview builds; the live site is unaffected.
  "previews": {},
  // ACCOUNTS DATABASE (the database id is not a secret):
  "d1_databases": [{ "binding": "DB", "database_name": "toddy-accounts", "database_id": "8843623f-1f66-4d6b-9e9a-8524626d69c6" }],
  // Secrets GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and SESSION_SECRET are set in the Cloudflare dashboard, never here.
  // GAMES / BACKEND — reserved for later, intentionally not enabled yet.
  // When scores, Passport or server-side validation are built, a Worker script
  // is added alongside these static assets, for example:
  //   "main": "server/index.js",
  //   "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/api/*"] }
  // Secrets (API keys, signing keys) belong in Cloudflare secrets, never in this file.
}
