{
  "name": "toddy-meme",
  "compatibility_date": "2026-10-06",
  // Server: the Worker answers ONLY /api/*; every other address is the static site, as before.
  "main": "server/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Serve /404.html (with a real 404 status) for unknown URLs instead of a blank error.
    "not_found_handling": "404-page"
  },
  // Private preview copies for test branches (e.g. games-beta). Needed by
  // `npx wrangler preview` in Cloudflare's preview builds; the live site is unaffected.
  "previews": {},
  // DATABASE (Season platform): the TEST database. The real one is created before the December rehearsal.
  // The Database ID is not a secret.
  "d1_databases": [
    { "binding": "DB", "database_name": "toddy-season-dev", "database_id": "83d03f27-0b39-4b0d-866d-4d9d28fd003d", "migrations_dir": "server/migrations" }
  ]
  // Secrets (API keys, signing keys) belong in Cloudflare secrets, never in this file.
}
