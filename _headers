# ============================================================
#  toddy.meme — HTTP response headers (Cloudflare Workers static assets)
#  File format: https://developers.cloudflare.com/workers/static-assets/headers/
#  Applies to every file served from this folder.
# ============================================================

/*
# --- Content Security Policy -------------------------------------------
# Only this site's own files may run or load. No inline scripts/styles.
# Google Fonts is the single third-party origin (fonts only).
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# --- Transport / framing / sniffing -------------------------------------
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin

# --- Browser features this site never needs -----------------------------
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), interest-cohort=()

# Images, video and icons: cache for a day, then refresh in the background.
# (File names are not versioned, so a long "immutable" cache would leave
#  visitors with stale logos after a replacement.)
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Security contact file must be fetchable by scanners and researchers.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# ------------------------------------------------------------
#  GAMES (added 2026-10-12): /games/moon-brew/ and /games/night-shift/
# ------------------------------------------------------------
#  Each game folder detaches the site-wide CSP ("! ...") and sets its own,
#  because two CSPs combine into the stricter one and would block the games.
#  Differences from the site policy: blob: for share pictures and sound,
#  workers allowed from blob:, and no Google Fonts (games use their own).
#  The /games/ page itself keeps the site policy above (it uses Google Fonts).
#  Same policy as the games' automatic browser tests in the toddy-games repo.
#  Game files are not all versioned by name, so they get the same day-long
#  cache as /assets/* instead of a year-long "immutable" one.
/games/moon-brew/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self'; font-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/games/night-shift/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self'; font-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/games/*/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/games/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
