# ============================================================
#  toddy.meme — HTTP response headers (Cloudflare Workers static assets)
#  File format: https://developers.cloudflare.com/workers/static-assets/headers/
#  Applies to every file served from this folder.
# ============================================================

/*
# --- Content Security Policy -------------------------------------------
# Only this site's own files may run or load. No inline scripts/styles.
# Google Fonts is the single third-party origin (fonts only).
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# --- Transport / framing / sniffing -------------------------------------
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin

# --- Browser features this site never needs -----------------------------
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), interest-cohort=()

# Images, video and icons: cache for a day, then refresh in the background.
# (File names are not versioned, so a long "immutable" cache would leave
#  visitors with stale logos after a replacement.)
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Security contact file must be fetchable by scanners and researchers.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# ------------------------------------------------------------
#  GAMES — /games/ hub and every game under /games/<name>/
# ------------------------------------------------------------
#  Rules from "/*" AND this more specific path both apply, and two CSP headers
#  would combine into the stricter one. So the site-wide CSP is detached first
#  ("! Content-Security-Policy"), then the games policy is set. It differs from
#  the site policy only by: blob: images/media/workers (share-card pictures,
#  game engines), self-hosted fonts allowed. No inline code, no outside scripts.
#  After every deploy: open /games/moon-brew/ with the browser console open and
#  confirm there are no "Refused to ... Content Security Policy" messages, and
#  that `curl -sI https://<preview>/games/moon-brew/` shows ONE CSP header.
/games/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Game pictures and sounds have versioned names (zone_asset_vNN): cache a day,
# refresh in the background (same as the site's /assets/*).
/games/*/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
