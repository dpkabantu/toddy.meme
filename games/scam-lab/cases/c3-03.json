  "title": "Double Your Coins Live",
  "disguise": "influencer",
  "intro": [
    "A \"live stream\" is running: a famous trader is giving away coins.",
    "The chat moderator messages you directly.",
    "Talk back, and sniff what they say."
  ],
  "notify": {
    "app": "Chirp",
    "from": "MaxLive Mod",
    "text": "🔴 You're selected for the 2x event!"
  },
  "screen": {
