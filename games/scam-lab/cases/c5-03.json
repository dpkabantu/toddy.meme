  "clues": {
    "acct": {
      "label": "A \"balance\" in their app",
      "strength": "strong",
      "lens": "The balance is just a number they control.",
      "why": "A balance in a stranger's app is not money you own."
    },
    "bal": {
      "label": "Small earnings shown",
      "strength": "strong",
      "lens": "They show £135, enough to feel real.",
      "why": "Small earnings build trust."
    },
    "dep": {
      "label": "A deposit to unlock",
      "strength": "strong",
      "lens": "You must pay £500 to withdraw.",
      "why": "Real jobs never make you pay to be paid."
    },
    "rule": {
      "label": "\"Company policy\"",
      "strength": "strong",
      "lens": "They explain it away.",
      "why": "A reason does not make it right."
    },
    "proof": {
      "label": "\"Others withdrew\"",
      "strength": "strong",
      "lens": "A crowd you cannot see.",
      "why": "A crowd proves nothing."
    },
    "shot": {
      "label": "A screenshot of a big balance",
      "strength": "strong",
      "lens": "Screenshots can be made by anyone.",
      "why": "Never trust a screenshot."
    },
    "rush": {
      "label": "Offer ends tonight",
      "strength": "strong",
      "lens": "A deadline.",
      "why": "Pressure is a trick."
    },
    "more": {
      "label": "A new problem and more money",
      "strength": "strong",
      "lens": "After you pay, there is always one more fee.",
      "why": "Scammers keep inventing fees."
    },
    "again": {
      "label": "\"Pay or lose everything\"",
      "strength": "strong",
      "lens": "They threaten you with loss.",
