              " ",
              {
                "clue": "vip",
                "text": "VIP members pay less"
              },
              "."
            ]
          }
        ],
        "replies": [
          {
            "text": "Fine, sending the top-up",
            "end": "go_ahead"
          },
          {
            "text": "I will not pay. Reporting",
            "end": "block_report"
          },
          {
            "text": "I will look up the company first",
            "end": "verify"
          }
        ]
      }
    }
  },
  "clues": {
