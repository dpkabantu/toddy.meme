        ]
      },
      "n2": {
        "say": [
          {
            "msg": [
              "Send 300 USDT to the company wallet. ",
              {
                "clue": "back",
                "text": "You will get 500 back"
              },
              " when the tasks finish. ",
              {
                "clue": "rush",
                "text": "Do it in 30 minutes"
              },
              "."
            ]
          }
        ],
        "replies": [
          {
            "text": "OK, sending",
            "end": "go_ahead"
          },
          {
            "text": "I will check the company myself",
            "end": "verify"
          },
          {
            "text": "No job charges to withdraw. Reporting",
            "end": "block_report"
          }
        ]
      },
      "n3": {
        "say": [
          {
            "msg": [
              "All our staff do it. ",
              {
                "clue": "others",
